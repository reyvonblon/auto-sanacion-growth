# Configuración opcional para envíos automáticos (solo la configura el hijo una vez)
# 1. Correo automático (Gmail con Contraseña de Aplicación, Brevo, Resend o SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 2. Webhook de publicación automática a redes (Make.com, Zapier, n8n o Buffer)
SOCIAL_WEBHOOK_URL=
